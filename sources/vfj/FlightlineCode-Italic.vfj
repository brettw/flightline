    "openTypeFeatures":[
      {
        "feature":"languagesystem DFLT dflt;\r\nlanguagesystem latn dflt;\r\nlanguagesystem grek dflt;\n\n@aboveMarks = [\n    gravecomb acutecomb circumflexcomb tildecomb macroncomb brevecomb\n    dotaccentcomb dieresiscomb ringcomb hungarumlautcomb caroncomb\n];\n"
      },
      {
        "name":"ccmp",
        "feature":"feature ccmp {\n  lookupflag UseMarkFilteringSet @aboveMarks;\n  sub i' @aboveMarks by dotlessi;\n  sub j' @aboveMarks by dotlessj;\n} ccmp;\n"
      },
      {
        "name":"frac",
        "feature":"feature frac {\n  sub one slash two by onehalf;\n  sub one slash three by onethirds;\n  sub one slash four by onequarter;\n  sub one slash eight by oneeighth;\n  sub two slash three by twothirds;\n  sub three slash four by threequarters;\n  sub three slash eight by threeeighths;\n  sub five slash eight by fiveeighths;\n  sub seven slash eight by seveneighths;\n} frac;\n"
      },
      {
        "name":"ordn",
        "feature":"feature ordn {\n  sub [zero one two three four five six seven eight nine] A' by ordfeminine;\n  sub [zero one two three four five six seven eight nine] a' by ordfeminine;\n  sub [zero one two three four five six seven eight nine] O' by ordmasculine;\n  sub [zero one two three four five six seven eight nine] o' by ordmasculine;\n} ordn;\n"
      },
      {
        "name":"salt",
        "feature":"feature salt {\n  sub asterisk from [asterisk.alt];\n  sub zero from [zero.alt];\n} salt;\n"
      },
      {
        "name":"sups",
        "feature":"feature sups {\n  sub zero by zerosuperior;\n  sub one by onesuperior;\n  sub two by twosuperior;\n  sub three by threesuperior;\n} sups;\n"
      }
    ],
